{
 "doctype": "DocType",
 "name": "Appointment",
 "module": "Krcti Mhpss",
 "custom": 0,
 "engine": "InnoDB",
 "naming_rule": "Expression",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "sec_who",
  "client_id",
  "client_name",
  "scholar_code",
  "col_1",
  "counsellor_id",
  "counsellor_name",
  "sec_when",
  "date_time",
  "duration_minutes",
  "end_time",
  "col_2",
  "session_type",
  "mode_of_contact",
  "location",
  "sec_status",
  "status",
  "overdue_notification_read",
  "overdue_notification_emailed",
  "notes",
  "sec_record",
  "session_details",
  "presenting_issues",
  "issue_subclassifications",
  "interventions_applied",
  "referrals_made",
  "urgency_level",
  "risk_assessment",
  "follow_up_plan",
  "followup_goals_discussed",
  "progress_previous_goals",
  "followup_challenges",
  "followup_new_issues_present",
  "followup_new_issues",
  "followup_evident_changes_present",
  "followup_evident_changes",
  "followup_coping_support",
  "followup_support_effectiveness",
  "followup_additional_support",
  "followup_mood_affect",
  "followup_mood_other",
  "followup_engagement_level",
  "followup_risk_concerns",
  "counsellor_observations",
  "followup_recommendations",
  "followup_takeaways",
  "next_session_focus",
  "followup_action",
  "audio_recording",
  "referral_history"
 ],
 "fields": [
  {
   "fieldname": "sec_who",
   "fieldtype": "Section Break",
   "label": "Who"
  },
  {
   "fieldname": "client_id",
   "fieldtype": "Link",
   "label": "Client",
   "options": "Client",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "client_name",
   "fieldtype": "Data",
   "label": "Client name",
   "fetch_from": "client_id.full_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "scholar_code",
   "fieldtype": "Data",
   "label": "Scholar/Participant Code",
   "fetch_from": "client_id.scholar_code",
   "read_only": 1
  },
  {
   "fieldname": "col_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "counsellor_id",
   "fieldtype": "Link",
   "label": "Counsellor",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "counsellor_name",
   "fieldtype": "Data",
   "label": "Counsellor name",
   "fetch_from": "counsellor_id.full_name",
   "read_only": 1
  },
  {
   "fieldname": "sec_when",
   "fieldtype": "Section Break",
   "label": "When and how"
  },
  {
   "fieldname": "date_time",
   "fieldtype": "Datetime",
   "label": "Date and time",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "duration_minutes",
   "fieldtype": "Int",
   "label": "Duration (minutes)",
   "default": "60"
  },
  {
   "fieldname": "end_time",
   "fieldtype": "Datetime",
   "label": "Ends at",
   "read_only": 1
  },
  {
   "fieldname": "col_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "session_type",
   "fieldtype": "Select",
   "label": "Session type",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "\nFirst Session\nFollow-Up\nTermination"
  },
  {
   "fieldname": "mode_of_contact",
   "fieldtype": "Select",
   "label": "Mode of contact",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "\nPhysical Individual\nPhysical Group\nTele-counselling\nPhone Call\nSchool Campaign"
  },
  {
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Physical location",
   "mandatory_depends_on": "eval:[\"Physical Individual\",\"Physical Group\",\"School Campaign\"].includes(doc.mode_of_contact)"
  },
  {
   "fieldname": "sec_status",
   "fieldtype": "Section Break",
   "label": "Status"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Scheduled\nCompleted\nCancelled",
   "default": "Scheduled",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "default": "0",
   "fieldname": "overdue_notification_read",
   "fieldtype": "Check",
   "hidden": 1,
   "label": "Overdue notification read"
  },
  {
   "default": "0",
   "fieldname": "overdue_notification_emailed",
   "fieldtype": "Check",
   "hidden": 1,
   "label": "Overdue notification emailed"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "sec_record",
   "fieldtype": "Section Break",
   "label": "Session Record"
  },
  {
   "fieldname": "session_details",
   "fieldtype": "Small Text",
   "label": "Session details"
  },
  {
   "fieldname": "presenting_issues",
   "fieldtype": "Small Text",
   "label": "Presenting issues"
  },
  {
   "fieldname": "issue_subclassifications",
   "fieldtype": "Small Text",
   "label": "Issue subclassifications"
  },
  {
   "fieldname": "interventions_applied",
   "fieldtype": "Small Text",
   "label": "Interventions applied"
  },
  {
   "fieldname": "referrals_made",
   "fieldtype": "Small Text",
   "label": "Referrals made"
  },
  {
   "fieldname": "urgency_level",
   "fieldtype": "Select",
   "label": "Urgency level",
   "options": "\nLow\nModerate\nHigh\nImmediate"
  },
  {
   "fieldname": "risk_assessment",
   "fieldtype": "Small Text",
   "label": "Risk assessment"
  },
  {
   "fieldname": "follow_up_plan",
   "fieldtype": "Small Text",
   "label": "Follow-up plan"
  },
  {
   "fieldname": "progress_previous_goals",
   "fieldtype": "Small Text",
   "label": "What progress or changes has the student made?",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_goals_discussed",
   "fieldtype": "Small Text",
   "label": "Goals/issues discussed last time",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_challenges",
   "fieldtype": "Small Text",
   "label": "Challenges or setbacks noted",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_new_issues_present",
   "fieldtype": "Select",
   "label": "Any new issues or stressors?",
   "options": "\nYes\nNo",
   "depends_on": "eval:doc.session_type==\"Follow-Up\"",
   "mandatory_depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_new_issues",
   "fieldtype": "Small Text",
   "label": "New issues or stressors shared",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_evident_changes_present",
   "fieldtype": "Select",
   "label": "Any evident changes?",
   "options": "\nYes\nNo",
   "depends_on": "eval:doc.session_type==\"Follow-Up\"",
   "mandatory_depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_evident_changes",
   "fieldtype": "Small Text",
   "label": "Evident changes",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_coping_support",
   "fieldtype": "Small Text",
   "label": "Coping skills or supports the client is using",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_support_effectiveness",
   "fieldtype": "Small Text",
   "label": "How effective do they seem?",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_additional_support",
   "fieldtype": "Small Text",
   "label": "Additional support needed",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_mood_affect",
   "fieldtype": "Select",
   "label": "Mood and affect",
   "options": "\nStable\nImproved\nLow\nAnxious\nWithdrawn\nOther",
   "depends_on": "eval:doc.session_type==\"Follow-Up\"",
   "mandatory_depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_mood_other",
   "fieldtype": "Small Text",
   "label": "Other mood or affect",
   "depends_on": "eval:doc.session_type==\"Follow-Up\" && doc.followup_mood_affect==\"Other\""
  },
  {
   "fieldname": "followup_engagement_level",
   "fieldtype": "Select",
   "label": "Engagement level",
   "options": "\nActive\nModerate\nPassive",
   "depends_on": "eval:doc.session_type==\"Follow-Up\"",
   "mandatory_depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_risk_concerns",
   "fieldtype": "Select",
   "label": "Risk concerns",
   "options": "\nNone\nMild\nModerate\nHigh",
   "depends_on": "eval:doc.session_type==\"Follow-Up\"",
   "mandatory_depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "counsellor_observations",
   "fieldtype": "Small Text",
   "label": "Counsellor observations",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "next_session_focus",
   "fieldtype": "Small Text",
   "label": "Focus for next session",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_recommendations",
   "fieldtype": "Small Text",
   "label": "Recommendations",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_takeaways",
   "fieldtype": "Small Text",
   "label": "Key takeaways or interventions used today",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "followup_action",
   "fieldtype": "Small Text",
   "label": "Follow-up action (if any)",
   "depends_on": "eval:doc.session_type==\"Follow-Up\""
  },
  {
   "fieldname": "audio_recording",
   "fieldtype": "Attach",
   "label": "Session audio recording",
   "description": "Optional private audio recording attached to this session."
  },
  {
   "fieldname": "referral_history",
   "fieldtype": "Table",
   "label": "Referral history",
   "options": "Appointment Referral",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "MHPSS Counsellor",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "autoname": "format:APT-{#####}",
 "title_field": "client_name",
 "show_title_field_in_link": 1
}
